# Copy to .env.local and fill in what you have. Every integration in this
# app degrades gracefully (shows a gap, a refusal, or a cached/demo value)
# when its env vars are unset — nothing crashes just because a key is
# missing. See README "Data sources and licences" for how to obtain each key
# and what to verify before production use.

# --- LLM provider (assistant's explanation/retrieval step) -----------------
# Any OpenAI Chat Completions-compatible endpoint: Vercel AI Gateway, OpenAI,
# a self-hosted Ollama server, etc. If unset, the assistant still answers
# dose-refusals, rules-grounded weather answers, and out-of-scope refusals
# correctly (those never touch the LLM) — but KB "explanation" answers fall
# back to showing the raw approved source text instead of an LLM paraphrase.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Mandi prices ------------------------------------------------------
# data.gov.in Agmarknet dataset. Register at https://data.gov.in, then open
# your specific dataset's own "API" tab to get its resource ID — do not
# assume a resource ID without checking, some daily-price datasets there
# have no API at all and require clicking "Request API" first.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=

# CEDA Agri Market API (Ashoka University) — fallback/history provider.
# Register at https://api.ceda.ashoka.edu.in/. Its terms require showing a
# CEDA attribution wherever its data appears (already wired into the prices
# page — see components/CedaAttribution.tsx).
CEDA_API_KEY=
CEDA_API_BASE_URL=

# --- Voice (Bhashini / Sarvam) ----------------------------------------
# Unset (or "browser"): the client uses the browser's own Web Speech API —
# works today, zero extra signup, but is not a true on-device offline model.
VOICE_PROVIDER=

# Bhashini (bhashini.gov.in) — register via the ULCA onboarding flow at
# https://bhashini.gitbook.io/bhashini-apis/pre-requisites-and-onboarding
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Sarvam AI (docs.sarvam.ai)
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=

# --- Alert delivery bots (optional, in addition to in-app notifications) ---
# Telegram: create a bot with @BotFather, put its token here. The farmer
# messages the bot /start once and pastes the resulting chat ID into Settings.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API — needs Meta Business verification + an approved
# message template; budget time for that before relying on this.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
